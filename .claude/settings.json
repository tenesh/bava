{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git grep *)",
      "Bash(git ls-files *)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(go list *)",
      "Bash(gofmt -l *)",
      "Bash(npm --prefix frontend run *)",
      "Bash(npm --prefix frontend test)",
      "Bash(npm --prefix frontend ci)",
      "Bash(wails3 generate bindings *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)"
    ],
    "deny": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git tag *)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(git branch -m *)",
      "Bash(git branch -M *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git worktree *)",
      "Bash(git stash *)",
      "Bash(git reset *)",
      "Bash(git restore *)",
      "Bash(git rebase *)",
      "Bash(git merge *)",
      "Bash(git cherry-pick *)",
      "Bash(git revert *)",
      "Bash(git rm *)",
      "Bash(git mv *)",
      "Bash(git clean *)",
      "Bash(git filter-repo *)",
      "Bash(git remote *)",
      "Bash(git -C *)",
      "Bash(go build*)",
      "Bash(wails3 dev*)",
      "Bash(wails3 build*)",
      "Bash(wails3 task*)",
      "Edit(**/com.tharabyte.bava.yml)",
      "Edit(**/com.tharabyte.bava.yaml)",
      "Edit(**/com.tharabyte.bava.json)"
    ]
  }
}
