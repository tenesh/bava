{
  "name": "reopen",
  "folders": ["${SCRATCH}/Smoke"],
  "steps": [
    { "do": "wait", "target": "header", "timeoutMs": 30000 },
    { "do": "menu", "target": "file.openSpace" },
    { "do": "wait", "target": "[data-path='First page.md']" },
    { "do": "click", "target": "[data-path='First page.md']" },
    { "do": "wait", "target": "header", "text": "First page" },
    { "do": "menu", "target": "view.document" },
    { "do": "wait", "target": ".bava-doc", "text": "Written in the smoke run" },
    { "do": "wait", "target": ".bava-doc .math-inline .katex" },
    { "do": "wait", "target": ".bava-doc .code-block", "text": "x := 1" },
    { "do": "wait", "target": ".bava-doc figure.media[data-kind='image'][data-state='ready'] img[src*='attachments']" },
    { "do": "wait", "target": ".bava-doc .card[data-kind='file'][data-state='ready']", "text": "notes.pdf" },
    { "do": "wait", "target": ".bava-doc figure.media[data-kind='online'] button.media-play" },
    { "do": "wait", "target": ".media-row", "text": "logo.png" },
    { "do": "click", "target": "button[aria-label='Open Media']" },
    { "do": "wait", "target": ".media-dialog [data-name='logo.png']" },
    { "do": "click", "target": ".media-dialog [data-name='logo.png']" },
    { "do": "wait", "target": ".media-dialog .media-used-by", "text": "First page" },
    { "do": "shot", "name": "media" },
    { "do": "click", "target": ".bava-dialog-close" },
    { "do": "gone", "target": ".media-dialog" },
    { "do": "wait", "target": ".bava-doc table", "text": "Cell one" },
    { "do": "wait", "target": ".bava-doc a[href='Target.md']", "text": "Target" },
    { "do": "click", "target": "[data-path='Target.md']" },
    { "do": "wait", "target": "header", "text": "Target" },
    { "do": "wait", "target": "nav.backlinks", "text": "First page" },
    { "do": "key", "text": "F2", "target": "[data-path='Target.md']" },
    { "do": "wait", "target": "input.rename" },
    { "do": "type", "text": "Goal" },
    { "do": "key", "text": "Enter" },
    { "do": "wait", "target": "[data-path='Goal.md']" },
    { "do": "click", "target": "[data-path='First page.md']" },
    { "do": "wait", "target": ".bava-doc a[href='Goal.md']", "text": "Goal" },
    { "do": "menu", "target": "view.canvas" },
    { "do": "wait", "target": "footer", "text": "Nodes 1" },
    { "do": "shot", "name": "reopened" }
  ]
}
