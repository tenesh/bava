{
  "name": "create",
  "folders": ["${SCRATCH}"],
  "files": [["${REPO}/testdata/fixtures/media/logo.png"], ["${REPO}/testdata/fixtures/media/notes.pdf"]],
  "steps": [
    { "do": "wait", "target": "text=New Space", "timeoutMs": 30000 },
    { "do": "shot", "name": "start" },
    { "do": "click", "target": "text=New Space" },
    { "do": "wait", "target": "#new-space-name" },
    { "do": "type", "text": "Smoke" },
    { "do": "click", "target": "text=Choose" },
    { "do": "click", "target": "text=Create" },
    { "do": "wait", "target": ".bava-space-switcher", "text": "Smoke" },
    { "do": "menu", "target": "file.new" },
    { "do": "wait", "target": "input.rename" },
    { "do": "type", "text": "Target" },
    { "do": "key", "text": "Enter" },
    { "do": "wait", "target": "header", "text": "Target" },
    { "do": "menu", "target": "file.new" },
    { "do": "wait", "target": "input.rename" },
    { "do": "type", "text": "First page" },
    { "do": "key", "text": "Enter" },
    { "do": "wait", "target": "header", "text": "First page" },
    { "do": "menu", "target": "view.document" },
    { "do": "wait", "target": ".bava-doc" },
    { "do": "click", "target": ".bava-doc" },
    { "do": "type", "text": "Written in the smoke run" },
    { "do": "wait", "target": "footer", "text": "5 words" },
    { "do": "key", "text": "Enter" },
    { "do": "type", "text": "See @Targ" },
    { "do": "wait", "target": "[role=listbox] [role=option]", "text": "Target" },
    { "do": "key", "text": "Enter" },
    { "do": "wait", "target": ".bava-doc a[href='Target.md']", "text": "Target" },
    { "do": "key", "text": "Enter" },
    { "do": "type", "text": "Area $x^2$" },
    { "do": "wait", "target": ".bava-doc .math-inline .katex" },
    { "do": "key", "text": "Enter" },
    { "do": "type", "text": "```go" },
    { "do": "key", "text": "Enter" },
    { "do": "type", "text": "x := 1" },
    { "do": "wait", "target": ".bava-doc .code-block", "text": "x := 1" },
    { "do": "key", "text": "ArrowDown" },
    { "do": "type", "text": "/image" },
    { "do": "key", "text": "Enter" },
    { "do": "wait", "target": ".bava-doc figure.media[data-kind='image'][data-state='ready']" },
    { "do": "type", "text": "/file" },
    { "do": "key", "text": "Enter" },
    { "do": "wait", "target": ".bava-doc .card[data-kind='file'][data-state='ready']", "text": "notes.pdf" },
    { "do": "type", "text": "/online" },
    { "do": "key", "text": "Enter" },
    { "do": "wait", "target": ".bava-doc .is-empty[data-placeholder='Paste a YouTube, Vimeo or Loom link']" },
    { "do": "paste", "text": "https://www.youtube.com/watch?v=aqz-KE-bpKQ" },
    { "do": "wait", "target": ".bava-doc figure.media[data-kind='online'] button.media-play" },
    { "do": "click", "target": ".bava-doc > p:last-child" },
    { "do": "type", "text": "/table" },
    { "do": "key", "text": "Enter" },
    { "do": "type", "text": "Cell one" },
    { "do": "wait", "target": ".bava-doc table", "text": "Cell one" },
    { "do": "click", "target": "text=Add tag" },
    { "do": "wait", "target": "input[aria-label='Add tag']" },
    { "do": "type", "text": "Smoke Run" },
    { "do": "key", "text": "Enter" },
    { "do": "key", "text": "Escape" },
    { "do": "wait", "target": "[role=group][aria-label=Tags]", "text": "smoke-run" },
    { "do": "menu", "target": "view.canvas" },
    { "do": "menu", "target": "tool.rect" },
    { "do": "drag", "target": "[data-side='canvas'] .konvajs-content", "from": [200, 160], "to": [360, 260] },
    { "do": "menu", "target": "file.save" },
    { "do": "wait", "target": "header", "text": "saved" },
    { "do": "wait", "target": "footer", "text": "Nodes 1" },
    { "do": "shot", "name": "saved" },

    { "do": "file", "target": "Smoke/First page.md", "text": "tags: [smoke-run]" },
    { "do": "file", "target": "Smoke/First page.md", "text": "Written in the smoke run" },
    { "do": "file", "target": "Smoke/First page.md", "text": "See [Target](Target.md)" },
    { "do": "file", "target": "Smoke/First page.md", "text": "Area $x^2$" },
    { "do": "file", "target": "Smoke/First page.md", "text": "```go\nx := 1\n```" },
    { "do": "file", "target": "Smoke/First page.md", "text": "](.bava/attachments/logo.png)" },
    { "do": "file", "target": "Smoke/First page.md", "text": "<!-- bava: card -->\n[notes.pdf](.bava/attachments/notes.pdf)" },
    { "do": "file", "target": "Smoke/First page.md", "text": "](https://www.youtube.com/watch?v=aqz-KE-bpKQ)" },
    { "do": "file", "target": "Smoke/First page.md", "text": "| Cell one |" },
    { "do": "file", "target": "Smoke/First page.md", "text": "\"type\": \"rect\"" }
  ]
}
