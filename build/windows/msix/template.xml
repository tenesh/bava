<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="bava"
        Arguments=""
        InstallLocation="C:\Program Files\Tharabyte\Bava">
    </Installer>
    <PackageInformation
        PackageName="Bava"
        PackageDisplayName="Bava"
        PublisherName="CN=Tharabyte"
        PublisherDisplayName="Tharabyte"
        Version="0.1.0.0"
        PackageDescription="Diagrams and documents, on your own disk.">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.tharabyte.bava"
                Description="Diagrams and documents, on your own disk."
                DisplayName="Bava"
                ExecutableName="bava"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Bava</DisplayName>
            <PublisherDisplayName>Tharabyte</PublisherDisplayName>
            <Description>Diagrams and documents, on your own disk.</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="bava.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
